# "none" = local single-user mode (no sign-in); "clerk" = multi-user cloud mode
AUTH_MODE=none
ENGINE_URL=http://127.0.0.1:8000
# Must equal the engine's MAKOR_ENGINE_SECRET (empty = engine runs open, local dev only)
ENGINE_SECRET=
# How long to wait for one extraction, including the engine's queue; the engine's own
# per-call bound is 300 s.
ENGINE_TIMEOUT_MS=600000
# Same directory scripts/run.sh uses, so a bare `npm run dev` and the run.sh stack share one SQLite file and master.key.
DATA_DIR=../data/web
# 32 random bytes, base64 (openssl rand -base64 32). Required in clerk mode; generated into DATA_DIR/master.key in none mode.
MAKOR_MASTER_KEY=
TRIAL_DOCS=5
# Requests a minute per API key on /api/v1/*, and separately on the registries search (0 = no limit).
API_RATE_LIMIT_PER_MIN=30
API_SEARCH_RATE_LIMIT_PER_MIN=20
# HH:MM Israeli time: a daily registries refresh while the server runs; empty = only an admin's Refresh all
MAKOR_REGISTRIES_REFRESH_AT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- clerk mode only (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Invited as the first admin on start while the instance has no admin (sign-up is invite-only).
MAKOR_ADMIN_EMAIL=
