# Makor — one .env for both apps (scripts/run.sh and docker compose read it).
# Never commit .env. Generate secrets with the commands in the comments.
# Comments go on their own line: docker compose reads `KEY=  # note` as the value "# note".

# --- deployment shape ---------------------------------------------------------
# clerk = multi-user cloud (sign-in, trial, BYOK); none = single local user, no sign-in
AUTH_MODE=clerk
# Public hostname; Caddy gets a Let's Encrypt certificate for it. `localhost` for a local smoke test.
MAKOR_DOMAIN=
# Optional override of the public origin the web app prints in curl snippets (default https://$MAKOR_DOMAIN)
NEXT_PUBLIC_SITE_URL=

# --- secrets ---------------------------------------------------------------------
# openssl rand -hex 32   — web ↔ engine shared secret, required by compose in both shapes
MAKOR_ENGINE_SECRET=
# openssl rand -base64 32 — encrypts stored results and BYOK keys; required in clerk mode, generated as master.key in none mode
MAKOR_MASTER_KEY=

# --- extraction backend ----------------------------------------------------------
# empty = anthropic under docker compose, ollama under scripts/run.sh (local)
MAKOR_BACKEND=
# empty = backend default (claude-opus-5 / qwen3-vl:8b-instruct); local choices: qwen3-vl:8b-instruct, qwen3-vl:30b-a3b-instruct (settings → Local model overrides per user)
MAKOR_MODEL=
# MAKOR_OLLAMA_URL=http://gpu-host:11434   # only for an Ollama elsewhere; unset = http://ollama:11434 (compose), http://localhost:11434 (run.sh)
# on (default) | off — one thumbnail call per frame decides what is read; off = read every region
MAKOR_CLASSIFY=
# empty = MAKOR_MODEL (recommended); claude-haiku-4-5 classes a cheque back as none — do not use. A differing model also makes the web app's per-document token sums span two models.
MAKOR_CLASSIFIER_MODEL=
# the classifier's effort on Anthropic (sent only to a model that accepts it); empty = the API default
MAKOR_CLASSIFY_EFFORT=low
# the service's own key: trial documents in clerk mode, everything in none mode without a BYOK key
ANTHROPIC_API_KEY=
TRIAL_DOCS=5
# requests a minute per API key on /api/v1/* (0 = no limit)
API_RATE_LIMIT_PER_MIN=30
# the same for /api/v1/registries/search, a synchronous FTS query per source
API_SEARCH_RATE_LIMIT_PER_MIN=20
# HH:MM Israeli time: the registries refresh by themselves every day (compose default 03:30); empty = only an admin's Refresh all
MAKOR_REGISTRIES_REFRESH_AT=03:30
ENGINE_TIMEOUT_MS=600000

# --- clerk mode only (https://dashboard.clerk.com) ------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# clerk mode: invited as the first admin while the instance has no admin (sign-up is invite-only)
MAKOR_ADMIN_EMAIL=
